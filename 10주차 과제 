        "import pandas as pd\n",
        "import statsmodels.formula.api as smf\n",
        "\n",
        "data = {\n",
        "    'humidity': [70, 65, 80, 55, 60, 85, 50, 75],\n",
        "    'pressure': [1013, 1012, 1015, 1010, 1011, 1016, 1009, 1014],\n",
        "    'temperature': [22.5, 24.0, 20.1, 26.5, 25.0, 18.5, 28.0, 21.3]\n",
        "}\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "model = smf.ols(formula='temperature ~ humidity + pressure', data=df).fit()\n",
        "\n",
        "new_data = {\n",
        "    'humidity': [60, 75],\n",
        "    'pressure': [1012, 1014]\n",
        "}\n",
        "new_df = pd.DataFrame(new_data)\n",
        "\n",
        "pred_frame = model.get_prediction(new_df).summary_frame(alpha=0.05)\n",
        "\n",
        "print('[예측 요약표]')\n",
        "print(pred_frame)"
      ],
