      "source": [
        "from pathlib import Path\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import statsmodels.formula.api as smf\n",
        "from statsmodels.stats.anova import anova_lm\n",
        "\n",
        "# 1. 데이터 경로 설정 및 로드\n",
        "DATA_DIR = Path('/content/drive/MyDrive/type3_week1')\n",
        "file_path = DATA_DIR / 'ad_age_sales.csv'\n",
        "\n",
        "try:\n",
        "    df = pd.read_csv(file_path)\n",
        "    print('[데이터 미리보기]')\n",
        "    print(df.head(), '\\n') [cite: 4]\n",
        "\n",
        "    # 2. 이원분산분석 모델 설정 및 적합 (상호작용 포함)\n",
        "    # formula: 구매금액 ~ C(광고유형) + C(연령대) + C(광고유형):C(연령대)\n",
        "    model = smf.ols('sales_amount ~ C(ad_type) + C(age_group) + C(ad_type):C(age_group)', data=df).fit()\n",
        "    anova_table = anova_lm(model, typ=2) [cite: 4]\n",
        "\n",
        "    # 3. 결과 출력\n",
        "    print('[ANOVA 결과표]')\n",
        "    print(anova_table, '\\n')\n",
        "\n",
        "    p_ad = anova_table.loc['C(ad_type)', 'PR(>F)']\n",
        "    p_age = anova_table.loc['C(age_group)', 'PR(>F)']\n",
        "    p_inter = anova_table.loc['C(ad_type):C(age_group)', 'PR(>F)']\n",
        "\n",
        "    print('[핵심 p-value]')\n",
        "    print('광고유형 p-value:', p_ad)\n",
        "    print('연령대 p-value:', p_age)\n",
        "    print('상호작용 p-value:', p_inter)\n",
        "\n",
        "    # 4. 결과 해석\n",
        "    print('\\n[결과 해석]')\n",
        "    if p_inter < 0.05:\n",
        "        print('상호작용 효과가 유의하므로, 광고유형의 효과는 연령대에 따라 달라진다고 해석합니다.') [cite: 4]\n",
        "    else:\n",
        "        print('상호작용 효과가 유의하지 않으므로, 광고유형과 연령대의 주효과 중심으로 해석합니다.') [cite: 4]\n",
        "\n",
        "except FileNotFoundError:\n",
        "    print(f\"오류: '{file_path}' 파일을 찾을 수 없습니다. 경로를 확인해주세요.\")"
      ],
