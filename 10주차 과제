        "from pathlib import Path\n",
        "import pandas as pd\n",
        "from scipy import stats\n",
        "\n",
        "# 1. 데이터 경로 설정 및 로드\n",
        "# 본인의 구글 드라이브나 로컬 경로에 맞춰 수정이 필요합니다 [cite: 1, 2]\n",
        "DATA_DIR = Path('/content/drive/MyDrive/type3_week1')\n",
        "file_path = DATA_DIR / 'branch_satisfaction.csv'\n",
        "\n",
        "try:\n",
        "    df = pd.read_csv(file_path)\n",
        "    print('[데이터 미리보기]')\n",
        "    print(df.head(), '\\n') [cite: 3]\n",
        "\n",
        "    # 2. 지점별 데이터 분리\n",
        "    a = df[df['branch'] == 'A']['score']\n",
        "    b = df[df['branch'] == 'B']['score']\n",
        "    c = df[df['branch'] == 'C']['score']\n",
        "\n",
        "    # 3. 일원분산분석(One-way ANOVA) 수행\n",
        "    result = stats.f_oneway(a, b, c)\n",
        "\n",
        "    # 4. 결과 출력 및 해석\n",
        "    means = df.groupby('branch')['score'].mean().sort_values(ascending=False)\n",
        "    print('[분석 결과]')\n",
        "    print('지점별 평균')\n",
        "    print(means, '\\n')\n",
        "    print('F-statistic:', round(result.statistic, 4))\n",
        "    print('p-value:', round(result.pvalue, 6))\n",
        "    print('평균이 가장 높은 지점:', means.index[0])\n",
        "\n",
        "    print('\\n[결과 해석]')\n",
        "    if result.pvalue < 0.05:\n",
        "        print('p-value가 0.05보다 작으므로, 지점 간 평균 고객만족도 차이가 유의하다고 해석할 수 있습니다.') [cite: 3]\n",
